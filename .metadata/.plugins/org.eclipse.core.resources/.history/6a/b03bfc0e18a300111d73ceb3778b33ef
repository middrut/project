<!DOCTYPE html>
<html xmlns:th="http://www.thymeleaf.org">
 
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
 
    <title>CSR Marketing Website</title>
 
    <!-- CSS -->
    <link rel="stylesheet" th:href="@{/CSS/style.css}">
</head>
 
<body>
 
    <!-- ================= NAVBAR ================= -->
 
    <header class="navbar">
        <div class="container nav-container">
 
            <h1 class="logo">
                CSR Marketing Website
            </h1>
 
            <nav>
                <a href="#home">Home</a>
                <a href="#about">About</a>
                <a href="#research">Research</a>
                <a href="#multimedia">Multimedia</a>
                <a href="#contact">Contact</a>
            </nav>
 
        </div>
    </header>
 
 
    <!-- ================= HERO ================= -->
 
    <section id="home" class="hero">
   
        <div class="hero-overlay">
   
            <div class="hero-content">
   
                <h2>
                    Social Media as a Tool for Marketing in
                    Corporate Social Responsibility (CSR)
                </h2>
   
                <p>
                    Learn how companies use Facebook, Instagram,
                    LinkedIn, YouTube and other social media platforms
                    to promote CSR initiatives, build brand trust
                    and create a positive impact on society.
                </p>
   
                <a href="#about" class="btn">
                    Learn More
                </a>
   
            </div>
   
        </div>
   
    </section>
    <!-- ================= ABOUT ================= -->
 
    <section id="about" class="section">
 
        <div class="container">
 
            <h2>About CSR</h2>
 
            <p>
                Corporate Social Responsibility (CSR) is a business
                approach where organizations contribute to society
                through ethical practices, sustainability, education
                and community development.
            </p>
 
            <p>
                Social media helps organizations communicate their
                CSR activities effectively, increase awareness,
                engage customers and build trust.
            </p>
 
            <div class="image-grid">
                <img th:src="@{/image/img1.png}" alt="CSR">
               
                <img th:src="@{/image/img2.webp}" alt="CSR">
               
                <img th:src="@{/image/img4.jpg}" alt="CSR">
                
				<p>Refernce From Google</p>
               
               
               
               
            </div>
 
        </div>
 
    </section>
 
 
    <!-- ================= RESEARCH ================= -->
 
    <section id="research" class="section light-section">
 
        <div class="container">
 
            <h2>Research</h2>
 
            <div class="cards">
 
                <div class="card">
                    <h3>Social Media Marketing</h3>
 
                    <p>
                        Social media platforms such as Facebook,
                        Instagram, LinkedIn, YouTube and X help
                        organizations communicate CSR initiatives
                        to a wider audience.
                    </p>
                </div>
 
 
                <div class="card">
                    <h3>Why CSR Needs Social Media</h3>
 
                    <p>
                        Social media provides faster communication,
                        transparency, higher public awareness,
                        customer engagement and improved brand
                        reputation.
                    </p>
                </div>
 
 
                <div class="card">
                    <h3>Research Findings</h3>
 
                    <p>
                        Research highlights the growing importance
                        of socially responsible brands and CSR
                        communication through digital platforms.
                    </p>
                </div>
 
            </div>
 
        </div>
 
    </section>
 
 
    <!-- ================= COMPANY EXAMPLES ================= -->
 
    <section class="section">
 
        <div class="container">
 
            <h2>Company Examples</h2>
 
            <div class="cards">
 
                <div class="card">
                    <h3>Microsoft</h3>
                    <p>Education and community development.</p>
                </div>
 
                <div class="card">
                    <h3>Google</h3>
                    <p>Sustainability and environmental initiatives.</p>
                </div>
 
                <div class="card">
                    <h3>Tata Group</h3>
                    <p>Healthcare and education.</p>
                </div>
 
                <div class="card">
                    <h3>Unilever</h3>
                    <p>Environmental protection.</p>
                </div>
 
            </div>
 
        </div>
 
    </section>
 
 
    <!-- ================= MULTIMEDIA ================= -->
 
    <section id="multimedia" class="section multimedia">
 
        <div class="container">
 
            <h2>Multimedia</h2>
 
            <!-- Poster -->
 
            <div class="media-block">
 
                <h3>CSR Poster</h3>
 
                <img th:src="@{/poster/csr-poster.png}" alt="CSR">
				<p>Refernce From Google</p>
 
            </div>
 
 
            <!-- Video -->
 
            <div class="media-block">
 
                <h3>CSR Video</h3>
 
                <video controls class="video-player">
 
                    <source
                        src="/video/csr-video.mp4"
                        type="video/mp4">
 
                    Your browser does not support video playback.
 
                </video>
				
				<p>Refernce From Google</p>
            </div>
 
 
            <!-- Presentation -->
 
            <div class="media-block">
 
                <h3>CSR Presentation</h3>
 
                <a
                    href="/ppt/CSR_Marketing_Presentation.pdf"
                    target="_blank"
                    class="btn">
 
                    View Presentation
 
                </a>
                    
				<p>Refernce From Google</p>
            </div>
 
        </div>
 
    </section>
 
 
    <!-- ================= AUDIO ================= -->
 
    <section class="audio-section">
 
        <div class="container">
 
            <h2>Background Music</h2>
 
            <button id="musicButton" class="btn">
                Play Music
            </button>
 
            <audio id="backgroundMusic" loop>
 
                <source
                    src="/audio/background.mp3"
                    type="audio/mpeg">
					
            </audio>
			<p>Refernce From Google</p>
        </div>
 
    </section>
   
   
 
	<!--================= CONTACT SECTION =================	-->
	
	<section class="contact-section" id="contact">
	    <div class="section-title">
	        <h2>Contact Us</h2>
	        <p>Have a question or want to get in touch? Send us a message.</p>
	    </div>
	
	```
	<div class="contact-grid">
	    <div class="contact-box">
	        <h3>Send Us a Message</h3>
	
	        <form action="#" method="post">
	            <div class="form-group">
	                <label for="name">Full Name</label>
	                <input
	                    type="text"
	                    id="name"
	                    name="name"
	                    placeholder="Enter your full name"
	                    required
	                >
	            </div>
	
	            <div class="form-group">
	                <label for="email">Email Address</label>
	                <input
	                    type="email"
	                    id="email"
	                    name="email"
	                    placeholder="Enter your email address"
	                    required
	                >
	            </div>
	
	            <div class="form-group">
	                <label for="subject">Subject</label>
	                <input
	                    type="text"
	                    id="subject"
	                    name="subject"
	                    placeholder="Enter message subject"
	                    required
	                >
	            </div>
	
	            <div class="form-group">
	                <label for="message">Message</label>
	                <textarea
	                    id="message"
	                    name="message"
	                    rows="6"
	                    placeholder="Write your message here"
	                    required
	                ></textarea>
	            </div>
	
	            <button type="submit" class="contact-btn">
	                Send Message
	            </button>
	        </form>
	    </div>
	
	    <div class="contact-box contact-info">
	        <h3>Contact Information</h3>
	
	        <p>
	            <strong>Address</strong>
	            <span>123 Demo Street, Toronto, ON M1M 1M1</span>
	        </p>
	
	        <p>
	            <strong>Phone</strong>
	            <span>+1 416-555-0123 </span>
	        </p>
	
	        <p>
	            <strong>Email</strong>
	            <span>info@example.com</span>
	        </p>
	
	        <p>
	            <strong>Working Hours</strong>
	            <span>Monday - Friday: 9:00 AM - 6:00 PM</span>
	        </p>
	    </div>
	</div>
	
	<div class="map-section">
	    <h3>Find Us on the Map</h3>
	
	    <iframe
	        src="https://www.google.com/maps?q=New%20Delhi%20India&output=embed"
	        width="100%"
	        height="350"
	        style="border: 0;"
	        allowfullscreen=""
	        loading="lazy"
	        referrerpolicy="no-referrer-when-downgrade">
	    </iframe>
	</div>
	```
	
	</section>

	
	
	
	

 
    <!-- ================= FOOTER ================= -->
 
    <footer>
 
        <p>
            © 2026 CSR Marketing Website. All Rights Reserved.
        </p>
 
    </footer>
 
 
    <!-- JavaScript -->
 
    <script src="/js/script.js"></script>
 
</body>
 
</html>