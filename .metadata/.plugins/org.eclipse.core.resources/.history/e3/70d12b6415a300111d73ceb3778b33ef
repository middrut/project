/* =========================================================
   CSR MARKETING WEBSITE - PROFESSIONAL STYLES
   ========================================================= */

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
}

body {
    font-family: Arial, Helvetica, sans-serif;
    background: #f5f7fb;
    color: #222;
    line-height: 1.7;
}

/* =========================================================
   COMMON
   ========================================================= */

.container {
    width: 90%;
    max-width: 1200px;
    margin: auto;
}

.section {
    padding: 80px 0;
}

.section h2 {
    text-align: center;
    font-size: 40px;
    margin-bottom: 30px;
    color: #123f7a;
}

.section p {
    font-size: 18px;
    margin-bottom: 18px;
}

/* =========================================================
   NAVBAR
   ========================================================= */

.navbar {
    background: linear-gradient(135deg, #123f7a, #1c63b8);
    color: white;
    padding: 20px 0;
    position: sticky;
    top: 0;
    z-index: 1000;
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.18);
}

.nav-container {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 30px;
}

.logo {
    font-size: 30px;
    font-weight: 700;
    letter-spacing: 0.5px;
}

nav {
    display: flex;
    align-items: center;
    gap: 30px;
}

nav a {
    color: white;
    text-decoration: none;
    font-size: 18px;
    font-weight: 600;
    position: relative;
    transition: 0.3s;
}

nav a::after {
    content: "";
    position: absolute;
    left: 0;
    bottom: -7px;
    width: 0;
    height: 3px;
    background: #ffb000;
    transition: width 0.3s;
}

nav a:hover {
    color: #ffd166;
}

nav a:hover::after {
    width: 100%;
}

/* =========================================================
   HERO
   ========================================================= */

.hero {
    min-height: 650px;
    background-image: url('/images/hero.jpg');
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    position: relative;
}

.hero-overlay {
    min-height: 650px;

    display: flex;
    align-items: center;
    justify-content: center;

    background:
        linear-gradient(
            rgba(5, 25, 55, 0.72),
            rgba(15, 60, 115, 0.62)
        );
}

.hero-content {
    width: 90%;
    max-width: 1050px;
    text-align: center;
    color: white;
}

.hero-content h2 {
    font-size: 52px;
    line-height: 1.18;
    margin-bottom: 28px;
    font-weight: 800;
    text-shadow: 0 3px 10px rgba(0, 0, 0, 0.35);
}

.hero-content p {
    font-size: 21px;
    line-height: 1.7;
    margin-bottom: 35px;
    color: #f4f8ff;
}

/* =========================================================
   BUTTON
   ========================================================= */

.btn {
    display: inline-block;
    padding: 15px 34px;

    background: linear-gradient(
        135deg,
        #ff9800,
        #ffb300
    );

    color: white;
    text-decoration: none;

    border: none;
    border-radius: 10px;

    font-size: 17px;
    font-weight: 700;

    cursor: pointer;

    box-shadow:
        0 8px 20px rgba(255, 152, 0, 0.35);

    transition: 0.3s;
}

.btn:hover {
    transform: translateY(-3px);
    box-shadow:
        0 12px 25px rgba(255, 152, 0, 0.45);
}

/* =========================================================
   ABOUT
   ========================================================= */

#about {
    background: white;
}

.image-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 25px;
    margin-top: 40px;
}

.image-grid img {
    width: 100%;
    height: 280px;
    object-fit: cover;

    border-radius: 15px;

    box-shadow:
        0 8px 25px rgba(0, 0, 0, 0.12);

    transition: 0.35s;
}

.image-grid img:hover {
    transform: translateY(-8px) scale(1.02);
    box-shadow:
        0 15px 30px rgba(0, 0, 0, 0.18);
}

/* =========================================================
   RESEARCH
   ========================================================= */

.light-section {
    background:
        linear-gradient(
            135deg,
            #eef5ff,
            #f9fbff
        );
}

.cards {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 28px;
    margin-top: 35px;
}

.card {
    background: white;
    padding: 32px;

    border-radius: 15px;

    box-shadow:
        0 8px 25px rgba(0, 0, 0, 0.08);

    border-top: 5px solid #1c63b8;

    transition: 0.3s;
}

.card:hover {
    transform: translateY(-8px);

    box-shadow:
        0 15px 30px rgba(0, 0, 0, 0.13);
}

.card h3 {
    color: #123f7a;
    font-size: 23px;
    margin-bottom: 15px;
}

.card p {
    font-size: 17px;
    color: #555;
}

/* =========================================================
   COMPANY EXAMPLES
   ========================================================= */

#research + .section {
    background: white;
}

#research + .section .card:nth-child(1) {
    border-top-color: #4caf50;
}

#research + .section .card:nth-child(2) {
    border-top-color: #2196f3;
}

#research + .section .card:nth-child(3) {
    border-top-color: #ff9800;
}

#research + .section .card:nth-child(4) {
    border-top-color: #9c27b0;
}

/* ================= CONTACT SECTION ================= */

.contact-section {
padding: 80px 20px;
background: #f7f9fc;
}

.section-title {
text-align: center;
margin-bottom: 50px;
}

.section-title h2 {
font-size: 38px;
margin-bottom: 12px;
}

.section-title p {
color: #666;
font-size: 17px;
}

.contact-grid {
display: grid;
grid-template-columns: 1fr 1fr;
gap: 35px;
max-width: 1100px;
margin: 0 auto;
}

.contact-box {
background: #ffffff;
padding: 35px;
border-radius: 15px;
box-shadow: 0 8px 30px rgba(0, 0, 0, 0.08);
}

.contact-box h3 {
font-size: 25px;
margin-bottom: 25px;
}

.form-group {
margin-bottom: 20px;
}

.form-group label {
display: block;
margin-bottom: 8px;
font-weight: 600;
}

.form-group input,
.form-group textarea {
width: 100%;
padding: 13px 15px;
border: 1px solid #ddd;
border-radius: 8px;
font-size: 15px;
box-sizing: border-box;
outline: none;
transition: 0.3s;
}

.form-group input:focus,
.form-group textarea:focus {
border-color: #2563eb;
box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.1);
}

.form-group textarea {
resize: vertical;
}

.contact-info p {
margin-bottom: 25px;
}

.contact-info strong {
display: block;
font-size: 15px;
margin-bottom: 7px;
}

.contact-info span {
display: block;
color: #666;
line-height: 1.6;
}

.map-section {
max-width: 1100px;
margin: 50px auto 0;
}

.map-section h3 {
margin-bottom: 20px;
font-size: 25px;
}

.map-section iframe {
border-radius: 15px;
box-shadow: 0 8px 30px rgba(0, 0, 0, 0.08);
}

/* ================= MOBILE ================= */

@media (max-width: 768px) {


.contact-grid {
    grid-template-columns: 1fr;
}

.contact-section {
    padding: 60px 15px;
}

.section-title h2 {
    font-size: 30px;
}

.contact-box {
    padding: 25px;
}





/* =========================================================
   MULTIMEDIA
   ========================================================= */

.multimedia {
    background:
        linear-gradient(
            135deg,
            #edf5ff,
            #ffffff
        );
}

.media-block {
    text-align: center;
    margin: 45px 0;
}

.media-block h3 {
    color: #123f7a;
    font-size: 25px;
    margin-bottom: 20px;
}

.poster-image {
    width: 100%;
    max-width: 850px;
    border-radius: 15px;

    box-shadow:
        0 10px 30px rgba(0, 0, 0, 0.15);
}

.video-player {
    width: 100%;
    max-width: 950px;
    border-radius: 15px;

    box-shadow:
        0 10px 30px rgba(0, 0, 0, 0.15);
}

/* =========================================================
   AUDIO
   ========================================================= */

.audio-section {
    text-align: center;
    padding: 65px 0;

    background:
        linear-gradient(
            135deg,
            #123f7a,
            #1d68bd
        );

    color: white;
}

.audio-section h2 {
    color: white;
    margin-bottom: 25px;
}

.audio-section .btn {
    margin-top: 10px;
}

/* =========================================================
   CONTACT
   ========================================================= */

#contact {
    background: white;
    text-align: center;
}

#contact p {
    max-width: 800px;
    margin: auto;
}

/* =========================================================
   FOOTER
   ========================================================= */

footer {
    background: #0c2340;
    color: #dbe7f5;
    text-align: center;
    padding: 25px 15px;
    font-size: 15px;
}

/* =========================================================
   RESPONSIVE
   ========================================================= */

@media (max-width: 900px) {

    .nav-container {
        flex-direction: column;
    }

    nav {
        flex-wrap: wrap;
        justify-content: center;
    }

    .hero-content h2 {
        font-size: 40px;
    }

    .cards {
        grid-template-columns: repeat(2, 1fr);
    }

    .image-grid {
        grid-template-columns: repeat(2, 1fr);
    }
}

@media (max-width: 600px) {

    .logo {
        font-size: 25px;
        text-align: center;
    }

    nav {
        gap: 15px;
    }

    nav a {
        font-size: 15px;
    }

    .hero {
        min-height: 600px;
    }

    .hero-overlay {
        min-height: 600px;
    }

    .hero-content h2 {
        font-size: 31px;
    }

    .hero-content p {
        font-size: 17px;
    }

    .section {
        padding: 55px 0;
    }

    .section h2 {
        font-size: 31px;
    }

    .cards {
        grid-template-columns: 1fr;
    }

    .image-grid {
        grid-template-columns: 1fr;
    }

    .image-grid img {
        height: 240px;
    }